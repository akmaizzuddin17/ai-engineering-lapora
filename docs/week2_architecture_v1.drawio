<mxfile host="app.diagrams.net"><diagram id="lapora-v1" name="Lapora V1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1790" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:24px;color:#1E3A5F&quot;&gt;Lapora — V1 Conceptual Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1500" height="34" as="geometry"/></mxCell><mxCell id="subtitle" value="&lt;span style=&quot;font-size:13px;color:#4B5563&quot;&gt;AI-assisted SSMxT (MPERS) concept tagging for SOFP and P&amp;amp;L line items · started from User → Application → AI Capability → Output; dashed components were added only where a requirement needs them&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="1700" height="24" as="geometry"/></mxCell><mxCell id="inset" value="" style="rounded=1;arcSize=4;fillColor=#F5F6F8;strokeColor=#B8BEC8;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="620" height="225" as="geometry"/></mxCell><mxCell id="inset_t" value="&lt;b style=&quot;font-size:13px;color:#1F2937&quot;&gt;Step C1 — simplest baseline (not sufficient)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="45" y="108" width="590" height="24" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b style=&quot;font-size:12px&quot;&gt;Preparer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFB;strokeColor=#3B82C4;" vertex="1" parent="1"><mxGeometry x="45" y="142" width="110" height="44" as="geometry"/></mxCell><mxCell id="be0" style="endArrow=block;html=1;strokeColor=#4B5563;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b style=&quot;font-size:12px&quot;&gt;Lapora&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE0E3;strokeColor=#D9485F;" vertex="1" parent="1"><mxGeometry x="195" y="142" width="110" height="44" as="geometry"/></mxCell><mxCell id="be1" style="endArrow=block;html=1;strokeColor=#4B5563;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b style=&quot;font-size:12px&quot;&gt;Language model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#3F9E52;" vertex="1" parent="1"><mxGeometry x="345" y="142" width="110" height="44" as="geometry"/></mxCell><mxCell id="be2" style="endArrow=block;html=1;strokeColor=#4B5563;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b style=&quot;font-size:12px&quot;&gt;Suggested tag&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8B5CC7;" vertex="1" parent="1"><mxGeometry x="495" y="142" width="110" height="44" as="geometry"/></mxCell><mxCell id="inset_l" value="&lt;div style=&quot;font-size:11.5px;color:#374151;line-height:1.45&quot;&gt;&lt;b style=&quot;color:#B42318&quot;&gt;Why it fails Lapora's requirements:&lt;/b&gt;&lt;br&gt;• Model may invent concept IDs not in SSMxT → fails RAI1 / FR2&lt;br&gt;• No citation to the taxonomy entry → fails FR3&lt;br&gt;• No uncertainty flag, so weak guesses look confident → fails FR4 / RAI2&lt;br&gt;• Client data and advice requests pass straight through → fails RAI3 / RAI4 / FR5&lt;br&gt;• No way to measure accuracy against labelled data → cannot show NFR1 / O3&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="45" y="196" width="600" height="145" as="geometry"/></mxCell><mxCell id="U" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#3B82C4&quot;&gt;USER&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Preparer&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Junior accountant / audit associate with finalised MPERS statements&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DCEBFB;strokeColor=#3B82C4;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="180" height="130" as="geometry"/></mxCell><mxCell id="APP" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#D9485F&quot;&gt;APPLICATION / INTERFACE&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Lapora Tagging Interface&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Enter or paste SOFP / P&amp;amp;L line items; view and review suggestions&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;FR1 · FR7&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBE0E3;strokeColor=#D9485F;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="280" y="430" width="180" height="130" as="geometry"/></mxCell><mxCell id="SC" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#E08A1E&quot;&gt;CONTROL (ADDED)&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Input &amp;amp; Scope Check&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Rejects out-of-scope inputs; strips amounts, names, reg. numbers&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;FR5 · RAI3 · RAI4&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#E08A1E;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="530" y="430" width="180" height="130" as="geometry"/></mxCell><mxCell id="KA" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#3F9E52&quot;&gt;AI CAPABILITY (ADDED)&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Knowledge Access&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Finds candidate concepts whose meaning matches the line item&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;FR2 · FR3 · NFR1&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#3F9E52;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="780" y="430" width="180" height="130" as="geometry"/></mxCell><mxCell id="LM" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#3F9E52&quot;&gt;AI CAPABILITY&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Language Model Service&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Ranks candidates; writes a one-line reason per suggestion&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;FR2 · FR3&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2F4E4;strokeColor=#3F9E52;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1030" y="430" width="180" height="130" as="geometry"/></mxCell><mxCell id="OV" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#E08A1E&quot;&gt;CONTROL (ADDED)&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Output Validation&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Valid concept ID only · citation required · confidence threshold&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;RAI1 · FR4&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#E08A1E;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1280" y="430" width="180" height="130" as="geometry"/></mxCell><mxCell id="OUT" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#8B5CC7&quot;&gt;OUTPUT&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Ranked Suggestions&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Top-3 concepts with ID, label, confidence, citation, reason; 'Needs review' flag&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;FR2 · FR3 · FR4&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8B5CC7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1530" y="430" width="230" height="130" as="geometry"/></mxCell><mxCell id="KS" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#8B5CC7&quot;&gt;APPROVED KNOWLEDGE SOURCE (ADDED)&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Official taxonomy &amp;amp; guidance&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;SSMxT 2022 MPERS taxonomy (concept IDs, labels, definitions) · SSM MBRS FAQ &amp;amp; mTool manual · IFRS for SMEs taxonomy&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;O1 · RAI1&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8B5CC7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="700" y="215" width="340" height="115" as="geometry"/></mxCell><mxCell id="HR" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#E08A1E&quot;&gt;HUMAN OVERSIGHT (ADDED)&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Human Review &amp;amp; Confirmation&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Preparer accepts, changes or rejects every item; no auto-accept&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;FR6 · RAI2&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#E08A1E;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1530" y="640" width="230" height="120" as="geometry"/></mxCell><mxCell id="EXP" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#8B5CC7&quot;&gt;OUTPUT&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Reviewed mapping export&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Line item → concept ID, citation, reviewer decision (table)&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;FR6&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8B5CC7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1530" y="830" width="230" height="100" as="geometry"/></mxCell><mxCell id="EV" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#E08A1E&quot;&gt;EVALUATION POINT (ADDED)&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Evaluation &amp;amp; Logging&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;Records suggestions, confidence, citations, latency and model payloads; scores them against the test sets&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;NFR1–5 · RAI1–5&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#E08A1E;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="930" y="690" width="380" height="120" as="geometry"/></mxCell><mxCell id="TS" value="&lt;div style=&quot;font-size:9px;font-weight:700;letter-spacing:.06em;color:#8B5CC7&quot;&gt;EVALUATION DATA (ADDED)&lt;/div&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#1F2937;margin:3px 0 4px&quot;&gt;Labelled test sets&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.3&quot;&gt;T1 tagging set (≥100 items, gold concept IDs) · T2 scope set · T3 privacy set&lt;/div&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#B42318;margin-top:5px&quot;&gt;O3&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EEE6FA;strokeColor=#8B5CC7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="560" y="690" width="270" height="120" as="geometry"/></mxCell><mxCell id="e1" value="line items" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="U" target="APP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="items" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="APP" target="SC"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="labels only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="SC" target="KA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="candidates&lt;br&gt;+ sources" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="KA" target="LM"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="ranked&lt;br&gt;draft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#4B5563;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="LM" target="OV"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="validated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#4B5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=10;fontColor=#4B5563;labelBackgroundColo