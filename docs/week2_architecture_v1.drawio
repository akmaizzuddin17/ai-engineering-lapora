1" parent="1" source="HR" target="EV"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="700"/><mxPoint x="1420" y="762"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.7&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1F2937&quot;&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;display:inline-block;width:12px;height:12px;background:#DCEBFB;border:2px solid #3B82C4;vertical-align:middle&quot;&gt;&lt;/span&gt; User &amp;nbsp;&amp;nbsp;&lt;span style=&quot;display:inline-block;width:12px;height:12px;background:#FBE0E3;border:2px solid #D9485F;vertical-align:middle&quot;&gt;&lt;/span&gt; Application / Interface &amp;nbsp;&amp;nbsp;&lt;span style=&quot;display:inline-block;width:12px;height:12px;background:#E2F4E4;border:2px solid #3F9E52;vertical-align:middle&quot;&gt;&lt;/span&gt; AI / Model capability &amp;nbsp;&amp;nbsp;&lt;span style=&quot;display:inline-block;width:12px;height:12px;background:#EEE6FA;border:2px solid #8B5CC7;vertical-align:middle&quot;&gt;&lt;/span&gt; Data / Output &amp;nbsp;&amp;nbsp;&lt;span style=&quot;display:inline-block;width:12px;height:12px;background:#FFF3DF;border:2px solid #E08A1E;vertical-align:middle&quot;&gt;&lt;/span&gt; Control / evaluation&lt;br&gt;Dashed border = component added in Step C2 because a requirement needs it · &lt;b style=&quot;color:#B42318&quot;&gt;Red IDs&lt;/b&gt; = requirements the component supports · dashed arrows = control, refusal, logging and evaluation flows&lt;br&gt;V1 is conceptual: components are labelled by function; models, retrieval method, storage and UI framework are chosen in later topics.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="860" width="860" height="120" as="geometry"/></mxCell><mxCell id="scope" value="&lt;div style=&quot;font-size:11px;color:#374151;line-height:1.45&quot;&gt;&lt;b style=&quot;font-size:12px;color:#1F2937&quot;&gt;Scope boundary (this semester)&lt;/b&gt;&lt;br&gt;&lt;b&gt;In:&lt;/b&gt; SOFP and P&amp;amp;L line items · MPERS · ranked concept suggestions with citations&lt;br&gt;&lt;b&gt;Out:&lt;/b&gt; XBRL file generation · submission to SSM · MFRS · notes / text blocks · cash flow &amp;amp; equity statements · accounting, tax or legal advice&lt;br&gt;&lt;i&gt;Drafting aid only: the preparer stays responsible for the filing. The full FYP pipeline (trial balance → statements → XBRL) extends this core.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8BEC8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="500" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>